NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NUXT_PUBLIC_POSTHOG_KEY=
NUXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Server-only aliases (never NUXT_PUBLIC_*). Prefer either NUXT_ or plain SUPABASE_ names.
# NUXT_SUPABASE_URL=
# NUXT_SUPABASE_SECRET_KEY=
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=

# Server-only photo-metric worker connection. Never expose these as NUXT_PUBLIC_*.
# NUXT_INFERENCE_API_URL=https://your-gpu-worker.example
# NUXT_INFERENCE_API_TOKEN=
# NUXT_INFERENCE_CALLBACK_SECRET=
# NUXT_PUBLIC_SITE_URL=https://your-homelens-domain.example
